---
import { principios } from '../data/site';
const ondas = [
  'M0 12 H400',
  'M0 12 Q25 4 50 12 T100 12 T150 12 T200 12 T250 12 T300 12 T350 12 T400 12',
  'M0 14 Q20 6 40 14 T80 14 T120 14 T160 14 T200 14 T240 14 T280 14 T320 14 T360 14 T400 14',
];
---
<section class="sec cream" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Decisões de arquitetura</span>
      <h2 class="h-l" id="pr-h">Decisões que não se discutem,<br /><span class="dim">porque protegem crianças.</span></h2>
      <p>Tiradas das decisões registradas nos próprios repositórios. Cada uma resolveu um problema real que já tinha acontecido.</p>
    </div>
    <div class="linha rv"><span>Regra · dado nominal nunca vai para link público</span><span>3 decisões · 2 projetos</span></div>
    <div class="cartoes rv">
      {principios.map((p, i) => (
        <article class="cartao">
          <span class="mono">{p.rotulo}</span>
          <svg viewBox="0 0 400 24" preserveAspectRatio="none" aria-hidden="true"><path class:list={{ onda: i > 0 }} d={ondas[i]} stroke="rgba(21,22,15,.35)" fill="none" /></svg>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ondas = [...document.querySelectorAll<SVGPathElement>('.cartao .onda')];
    const area = document.querySelector('.cartoes');
    let t = 0, naTela = false, rodando = false;
    const anim = () => {
      if (!naTela || document.hidden) { rodando = false; return; }
      t += 0.03;
      ondas.forEach((w, i) => w.setAttribute('transform', `translate(${(Math.sin(t + i) * 10).toFixed(2)} 0)`));
      requestAnimationFrame(anim);
    };
    const retomar = () => { if (!rodando && naTela && !document.hidden) { rodando = true; requestAnimationFrame(anim); } };
    if (ondas.length && area) {
      new IntersectionObserver((es) => { naTela = !!es[0]?.isIntersecting; retomar(); }).observe(area);
      document.addEventListener('visibilitychange', retomar);
    }
  }
</script>

<style>
  .linha { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--color-cream-dim); text-transform: uppercase; padding-bottom: 12px; border-bottom: 1px dashed rgb(21 22 15 / .25); margin-bottom: 22px; }
  .cartoes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: end; }
  .cartao { position: relative; background: var(--color-lime); border-radius: 16px; padding: 18px 20px 22px; min-height: 230px; display: flex; flex-direction: column; overflow: hidden; transition: transform .35s cubic-bezier(.2, .7, .2, 1); }
  .cartao:hover { transform: translateY(-6px); }
  .cartao:nth-child(2) { min-height: 250px; background: #d6f877; }
  .cartao:nth-child(3) { min-height: 270px; background: #c5ef4f; }
  .cartao .mono { color: rgb(21 22 15 / .62); }
  .cartao svg { position: absolute; left: 0; right: 0; top: 46px; width: 100%; height: 24px; }
  .cartao h3 { margin-top: auto; font-size: 28px; }
  .cartao p { margin-top: 8px; font-size: 14px; color: rgb(21 22 15 / .72); max-width: 34ch; }
  @media (max-width: 860px) { .cartoes { grid-template-columns: 1fr; } .cartao, .cartao:nth-child(n) { min-height: 200px; } }
</style>
