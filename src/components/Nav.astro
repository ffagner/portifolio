---
import Marca from './Marca.astro';
import { nav, site } from '../data/site';
---
<nav class="nav" aria-label="Principal">
  <div class="wrap nav-in">
    <a class="brand" href="/" aria-label={`${site.nome}, início`}>
      <Marca />
      {site.nome}
    </a>
    <div class="nav-links">
      {nav.map((i) => <a href={i.href}>{i.rotulo}</a>)}
    </div>
    <div class="acoes">
      <button class="atalho" type="button" data-abrir-paleta aria-label="Buscar no site (Ctrl+K)">
        <span aria-hidden="true" data-tecla>Ctrl K</span>
      </button>
      <a class="btn btn-lime btn-sm cta" href="/#contato">Falar comigo <span class="arr" aria-hidden="true">→</span></a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-movel" data-menu-btn>
        <span class="menu-ico" aria-hidden="true"><i></i><i></i></span>
        <span class="menu-txt">Menu</span>
      </button>
    </div>
  </div>
  <div class="menu-movel" id="menu-movel" hidden data-menu>
    <div class="wrap">
      <ul>
        {nav.map((i, n) => (
          <li><a href={i.href} data-menu-link><span class="num">{String(n + 1).padStart(2, '0')}</span>{i.rotulo}</a></li>
        ))}
        <li><a href="/#contato" data-menu-link><span class="num">{String(nav.length + 1).padStart(2, '0')}</span>Contato</a></li>
      </ul>
      <button class="btn btn-glass busca" type="button" data-abrir-paleta>Buscar no site</button>
    </div>
  </div>
</nav>

<script>
  // No Mac o atalho é ⌘K; nos demais sistemas, Ctrl K.
  if (/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    const t = document.querySelector('[data-tecla]');
    if (t) t.textContent = '⌘K';
  }
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const alternar = (abrir: boolean) => {
      btn.setAttribute('aria-expanded', String(abrir));
      menu.hidden = !abrir;
      document.documentElement.classList.toggle('menu-aberto', abrir);
    };
    btn.addEventListener('click', () => alternar(menu.hidden));
    menu.querySelectorAll('[data-menu-link], [data-abrir-paleta]').forEach((a) => a.addEventListener('click', () => alternar(false)));
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { alternar(false); btn.focus(); } });
    matchMedia('(min-width: 821px)').addEventListener('change', (m) => { if (m.matches) alternar(false); });
  }
</script>

<style>
  .nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; backdrop-filter: blur(14px); background: rgb(13 14 10 / .62); border-bottom: 1px solid var(--line); }
  .nav-in { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 500; letter-spacing: -.01em; }
  .nav-links { display: flex; gap: 28px; }
  .nav-links a { font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--color-fg-dim); transition: color .2s; }
  .nav-links a:hover { color: var(--color-fg); }
  .acoes { display: flex; align-items: center; gap: 10px; }
  .atalho { height: 32px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--line-2); background: rgb(255 255 255 / .04); color: var(--color-fg-dim); font-family: var(--font-mono); font-size: 11px; cursor: pointer; transition: color .2s, border-color .2s; }
  .atalho:hover { color: var(--color-fg); border-color: var(--color-fg-dim); }
  .menu-btn { display: none; align-items: center; gap: 8px; height: 38px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--line-2); background: rgb(255 255 255 / .04); color: var(--color-fg); font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; }
  .menu-ico { display: grid; gap: 4px; width: 14px; }
  .menu-ico i { display: block; height: 1.5px; background: currentColor; transition: transform .25s; }
  .menu-btn[aria-expanded="true"] .menu-ico i:first-child { transform: translateY(2.75px) rotate(45deg); }
  .menu-btn[aria-expanded="true"] .menu-ico i:last-child { transform: translateY(-2.75px) rotate(-45deg); }
  .menu-movel { border-top: 1px solid var(--line); background: rgb(13 14 10 / .97); padding-block: 12px 24px; max-height: calc(100dvh - 64px - env(safe-area-inset-top, 0px)); overflow-y: auto; }
  .menu-movel ul { list-style: none; margin: 0; padding: 0; }
  .menu-movel li a { display: flex; align-items: baseline; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); font-size: 26px; letter-spacing: -.02em; text-decoration: none; color: var(--color-fg); }
  .menu-movel li a:hover { color: var(--color-lime); }
  .menu-movel .num { font-family: var(--font-mono); font-size: 11px; color: var(--color-lime); letter-spacing: .06em; }
  .menu-movel .busca { margin-top: 20px; width: 100%; justify-content: center; }
  @media (max-width: 820px) {
    .nav-links, .atalho { display: none; }
    .menu-btn { display: inline-flex; }
  }
  @media (max-width: 420px) { .cta { display: none; } }
</style>
