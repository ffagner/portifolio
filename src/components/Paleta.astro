---
/**
 * Paleta de comandos: Ctrl+K (ou Cmd+K) abre uma busca para pular para qualquer case ou seção.
 * Também abre por qualquer elemento com [data-abrir-paleta].
 */
import { getCollection } from 'astro:content';
import { nav, site } from '../data/site';

const cases = (await getCollection('cases')).sort((a, b) => a.data.ordem - b.data.ordem);
const itens = [
  ...cases.map((c) => ({ grupo: 'Cases', rotulo: c.data.titulo, detalhe: c.data.repos.join(' · '), href: `/cases/${c.id}/`, termos: `${c.data.chamada} ${c.data.stack.join(' ')}` })),
  ...nav.map((i) => ({ grupo: 'Seções', rotulo: i.rotulo, detalhe: 'Página inicial', href: i.href })),
  { grupo: 'Seções', rotulo: 'Contato', detalhe: 'Formulário e terminal', href: '/#contato' },
  { grupo: 'Links', rotulo: 'GitHub', detalhe: site.github.replace('https://', ''), href: site.github },
];
---
<dialog class="paleta" aria-labelledby="paleta-titulo" data-paleta>
  <h2 id="paleta-titulo" class="sr">Buscar no site</h2>
  <div class="campo">
    <span class="lupa" aria-hidden="true">⌕</span>
    <input type="text" placeholder="Buscar case ou seção…" autocomplete="off" spellcheck="false"
      role="combobox" aria-expanded="true" aria-controls="paleta-lista" aria-autocomplete="list" data-paleta-busca />
    <kbd>Esc</kbd>
  </div>
  <ul id="paleta-lista" role="listbox" aria-label="Resultados" data-paleta-lista>
    {itens.map((i, n) => (
      <li role="option" id={`paleta-op-${n}`} aria-selected={n === 0 ? 'true' : 'false'} data-href={i.href} data-texto={`${i.rotulo} ${i.detalhe} ${i.grupo} ${'termos' in i ? i.termos : ''}`.toLowerCase()}>
        <span class="g">{i.grupo}</span>
        <span class="r">{i.rotulo}</span>
        <span class="d">{i.detalhe}</span>
      </li>
    ))}
  </ul>
  <p class="vazio" hidden data-paleta-vazio>Nada encontrado. Tente "painel", "evasão" ou "contato".</p>
  <p class="dica mono"><span>↑↓ navegar</span><span>↵ abrir</span><span>Ctrl K abre e fecha</span></p>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-paleta]');
  if (dlg) {
    const busca = dlg.querySelector<HTMLInputElement>('[data-paleta-busca]')!;
    const itens = [...dlg.querySelectorAll<HTMLLIElement>('[role="option"]')];
    const vazio = dlg.querySelector<HTMLElement>('[data-paleta-vazio]')!;
    const normal = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    let visiveis = itens, atual = 0;

    const marcar = (i: number) => {
      atual = Math.max(0, Math.min(i, visiveis.length - 1));
      itens.forEach((li) => li.setAttribute('aria-selected', 'false'));
      const el = visiveis[atual];
      if (el) { el.setAttribute('aria-selected', 'true'); el.scrollIntoView({ block: 'nearest' }); busca.setAttribute('aria-activedescendant', el.id); }
      else busca.removeAttribute('aria-activedescendant');
    };
    const filtrar = () => {
      const q = normal(busca.value.trim());
      visiveis = itens.filter((li) => { const ok = !q || normal(li.dataset.texto ?? '').includes(q); li.hidden = !ok; return ok; });
      vazio.hidden = visiveis.length > 0;
      marcar(0);
    };
    const ir = (li?: HTMLLIElement) => {
      const href = li?.dataset.href;
      if (!href) return;
      dlg.close();
      if (href.startsWith('http')) window.open(href, '_blank', 'noopener');
      else location.href = href;
    };
    const abrir = () => { if (dlg.open) return; busca.value = ''; filtrar(); dlg.showModal(); busca.focus(); };

    addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : abrir(); }
    });
    document.querySelectorAll('[data-abrir-paleta]').forEach((b) => b.addEventListener('click', abrir));
    busca.addEventListener('input', filtrar);
    busca.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); marcar(atual + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); marcar(atual - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); ir(visiveis[atual]); }
    });
    itens.forEach((li) => {
      li.addEventListener('click', () => ir(li));
      li.addEventListener('mousemove', () => { const i = visiveis.indexOf(li); if (i !== atual) marcar(i); });
    });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  }
</script>

<style>
  .paleta { width: min(600px, calc(100% - 32px)); margin: min(18vh, 140px) auto auto; padding: 0; border-radius: 18px; border: 1px solid var(--line-2); background: linear-gradient(165deg, rgb(40 44 33 / .98), rgb(18 20 14 / .99)); color: var(--color-fg); box-shadow: 0 40px 100px -30px #000; overflow: hidden; }
  .paleta::backdrop { background: rgb(8 9 6 / .6); backdrop-filter: blur(8px); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .campo { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .lupa { color: var(--color-lime); font-size: 20px; line-height: 1; }
  .campo input { flex: 1; min-width: 0; background: transparent; border: 0; color: var(--color-fg); font: inherit; font-size: 17px; outline: none; }
  kbd { font-family: var(--font-mono); font-size: 10.5px; color: var(--color-fg-dim); border: 1px solid var(--line-2); border-radius: 6px; padding: 2px 6px; }
  ul { list-style: none; margin: 0; padding: 8px; max-height: min(52vh, 380px); overflow-y: auto; }
  li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 2px 12px; padding: 10px 12px; border-radius: 10px; cursor: pointer; }
  li[aria-selected="true"] { background: rgb(205 245 100 / .1); box-shadow: inset 2px 0 0 var(--color-lime); }
  .g { grid-row: span 2; align-self: center; font-family: var(--font-mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: var(--color-fg-dim); }
  .r { font-size: 15.5px; }
  .d { font-size: 12.5px; color: var(--color-fg-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .vazio { margin: 0; padding: 18px 20px; color: var(--color-fg-dim); font-size: 14px; }
  .dica { display: flex; gap: 16px; flex-wrap: wrap; margin: 0; padding: 10px 16px; border-top: 1px solid var(--line); color: var(--color-fg-dim); }
  @media (max-width: 520px) { .dica { display: none; } li { grid-template-columns: 1fr; } .g { grid-row: auto; } }
</style>
